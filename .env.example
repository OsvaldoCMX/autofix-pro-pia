# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.

# desarrollo, pruebas o produccion
APP_ENV=desarrollo

# Conexion a la base. En Render va la cadena Session pooler de Supabase.
DATABASE_URL=postgresql+psycopg://autofix:cambia-esta-clave@db:5432/autofix

# Solo para el servicio db de Docker Compose
POSTGRES_USER=autofix
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=autofix

# Token de cada empleado de demostracion (ADR-012)
TOKEN_ASESOR=cambia-este-token-asesor
TOKEN_TECNICO=cambia-este-token-tecnico
TOKEN_TECNICO_2=cambia-este-token-tecnico-2
TOKEN_GERENTE=cambia-este-token-gerente
TOKEN_COMPRAS=cambia-este-token-compras
TOKEN_CAJA=cambia-este-token-caja

# Solo para POST /api/revisiones/plazos (ADR-015)
TOKEN_SISTEMA=cambia-este-token-sistema

# Para los ingresos del dia y los dias habiles; las fechas se guardan en UTC
ZONA_HORARIA=America/Monterrey

# Puerto de Uvicorn (Render lo define)
PORT=8000

# Nivel de bitacora
LOG_LEVEL=info
